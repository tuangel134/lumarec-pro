<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/camera_widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp" android:background="@drawable/widget_idle">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/camera_widget_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="LumaRec" android:textColor="#FFF4F6" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" />
        <Chronometer android:id="@+id/camera_widget_timer" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FFF4F6" android:textSize="16sp" android:fontFamily="monospace" android:includeFontPadding="false" />
        <TextView android:id="@+id/camera_widget_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Lista" android:textColor="#FF9AAB" android:textSize="10sp" android:includeFontPadding="false" />
    </LinearLayout>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
        <Button android:id="@+id/camera_widget_record" android:layout_width="wrap_content" android:layout_height="32dp"
            android:text="Grabar" android:textAllCaps="false" android:textSize="11sp" android:textColor="#FFF4F6"
            android:background="@drawable/widget_idle" android:minWidth="0dp" android:minHeight="0dp" android:paddingLeft="8dp" android:paddingRight="8dp" />
        <Button android:id="@+id/camera_widget_pause" android:layout_width="wrap_content" android:layout_height="28dp"
            android:text="Pausar" android:textAllCaps="false" android:textSize="10sp" android:textColor="#FFF4F6"
            android:background="@android:color/transparent" android:minWidth="0dp" android:minHeight="0dp"
            android:paddingLeft="8dp" android:paddingRight="8dp" android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
