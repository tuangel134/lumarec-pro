<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.lumarec.pro">
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />
    <uses-feature android:name="android.hardware.camera.any" android:required="true" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <application android:name=".LumaRecApp" android:label="LumaRec Pro" android:theme="@style/AppTheme" android:icon="@drawable/ic_launcher" android:allowBackup="false" android:fullBackupContent="@xml/backup_rules" android:dataExtractionRules="@xml/data_extraction_rules" android:supportsRtl="true">
        <activity android:name=".MainActivity" android:exported="true" android:screenOrientation="portrait">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <activity android:name=".PrivatePlayerActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".QuickRecordActivity" android:exported="false" android:excludeFromRecents="true" android:launchMode="singleTop" android:taskAffinity="" android:screenOrientation="portrait" />
        <receiver android:name=".QuickRecordWidget" android:exported="false" android:label="@string/widget_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/quick_record_widget" />
        </receiver>
        <receiver android:name=".CameraRecordWidget" android:exported="false" android:label="@string/camera_widget_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/camera_record_widget" />
        </receiver>
        <receiver android:name=".RecordingPanelWidget" android:exported="false" android:label="@string/panel_widget_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/recording_panel_widget" />
        </receiver>
        <service android:name=".RecordTile" android:exported="true" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:label="LumaRec · Grabar" android:icon="@drawable/ic_widget_camera">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.ACTIVE_TILE" android:value="true" />
        </service>
        <service android:name=".RecordingService" android:exported="false" android:foregroundServiceType="camera|microphone" android:stopWithTask="false" />
        <provider android:name=".LocalMediaProvider" android:authorities="com.lumarec.pro.media" android:exported="false" android:grantUriPermissions="false">
            <grant-uri-permission android:pathPrefix="/outgoing/" />
        </provider>
    </application>
</manifest>
